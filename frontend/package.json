    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tanstack/vue-virtual": "^3.13.52",
    "@wailsio/runtime": "3.1.0",
    "pinia": "^4.1.0",
    "vue": "^3.2.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.4",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": "24.x"
